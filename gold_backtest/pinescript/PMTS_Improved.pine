//@version=5
// PMTS Improved — Pure Math Trading System (TradingView port)
// Port of gold_backtest/src/strategy_pmts.py → improved_params()
//
// CHART: BINANCE:PAXGUSDT (or gold), timeframe **15 minutes**
// Improvements ON by default:
//   • Tight fib 61.8%–70.5%
//   • Session 08:00–18:00 UTC
//   • HTF SMA(100) trend filter
//   • ATR percentile volatility gate
//   • BOS retest (no entry on BOS candle)
//   • Min stop 0.40%, RR 1:2, setup expiry 48h
//
// Honest note: Python improved PMTS was selective (~33% WR, few trades).
// TV will not match Python fills 1:1 — use this to visually verify the logic.

strategy(
     title                     = "PMTS Improved (1H OB + 15m BOS)",
     shorttitle                = "PMTS-IMP",
     overlay                   = true,
     pyramiding                = 0,
     process_orders_on_close   = true,
     calc_on_every_tick        = false,
     initial_capital           = 10000,
     default_qty_type          = strategy.percent_of_equity,
     default_qty_value         = 100,
     commission_type           = strategy.commission.percent,
     commission_value          = 0.1,
     slippage                  = 2,
     max_bars_back             = 5000
 )

// ═══════════════════════ Inputs ═══════════════════════
grpHTF = "1H Order Block / Fib"
htfTf         = input.timeframe("60", "HTF", group = grpHTF)
dispMult      = input.float(2.2, "Displacement body × median", step = 0.1, group = grpHTF)
dispLookback  = input.int(20, "Median body lookback", group = grpHTF)
minImpulseAtr = input.float(1.8, "Min impulse ATR mult", step = 0.1, group = grpHTF)
rangeMinBars  = input.int(3, "Range min bars", group = grpHTF)
rangeMaxBars  = input.int(14, "Range max bars", group = grpHTF)
rangeAtrFrac  = input.float(0.55, "Range width ATR frac", step = 0.05, group = grpHTF)
fibLo         = input.float(0.618, "Fib low (golden)", step = 0.001, group = grpHTF)
fibHi         = input.float(0.705, "Fib high (tight)", step = 0.001, group = grpHTF)
setupMaxHours = input.int(48, "Setup max age (hours)", group = grpHTF)

grpLTF = "15m Entry"
bosSwing     = input.int(3, "BOS swing lookback", group = grpLTF)
pinWickRatio = input.float(2.2, "Pin / rejection wick × body", step = 0.1, group = grpLTF)
useBosRetest = input.bool(true, "Require BOS retest (no entry on BOS bar)", group = grpLTF)
allowLong    = input.bool(true, "Allow longs", group = grpLTF)
allowShort   = input.bool(true, "Allow shorts", group = grpLTF)

grpFilt = "Improved Filters"
useSession = input.bool(true, "Session filter", group = grpFilt)
sessStart  = input.int(8, "Session start UTC", group = grpFilt)
sessEnd    = input.int(18, "Session end UTC", group = grpFilt)
useHtfSma  = input.bool(true, "HTF SMA trend filter", group = grpFilt)
smaLen     = input.int(100, "HTF SMA length", group = grpFilt)
useVolGate = input.bool(true, "ATR percentile gate", group = grpFilt)
volPctMin  = input.float(30.0, "Min ATR percentile", group = grpFilt)
volLookback = input.int(200, "ATR percentile lookback", group = grpFilt)

grpRisk = "Risk"
rrTarget     = input.float(2.0, "Reward : Risk", group = grpRisk)
minStopPct   = input.float(0.40, "Min stop %", step = 0.05, group = grpRisk) / 100.0
riskPct      = input.float(1.0, "Risk per trade % equity", group = grpRisk) / 100.0
cooldownBars = input.int(3, "Min bars between entries", group = grpRisk)

grpVis = "Visuals"
showZone    = input.bool(true, "Show active golden zone", group = grpVis)
showSignals = input.bool(true, "Show entry markers", group = grpVis)

// ═══════════════════════ HTF series ═══════════════════════
f_htf() =>
    body = math.abs(close - open)
    medBody = ta.median(body, dispLookback)
    atrV = ta.atr(14)
    smaV = ta.sma(close, smaLen)
    [open, high, low, close, body, medBody, atrV, smaV, time]

[htfO, htfH, htfL, htfC, htfBody, htfMedBody, htfAtr, htfSma, htfTime] =
     request.security(syminfo.tickerid, htfTf, f_htf(), barmerge.gaps_off, barmerge.lookahead_off)

newHtf = ta.change(htfTime) != 0
htfAtrPct = ta.percentrank(htfAtr, volLookback)

// ═══════════════════════ HTF state machine ═══════════════════════
// phase: 0 idle | 1 range after displacement | 2 wait structural break | 3 zone active
var int   phase        = 0
var int   setupDir     = 0
var int   rangeBars    = 0
var float rangeHi      = na
var float rangeLo      = na
var float impulseStart = na
var float impulseEnd   = na
var float obHi         = na
var float obLo         = na
var float zoneTop      = na
var float zoneBot      = na
var int   zoneExpiry   = na
var float activeObHi   = na
var float activeObLo   = na
var float boxHi        = na
var float boxLo        = na

if newHtf and not na(htfMedBody) and htfMedBody > 0 and not na(htfAtr) and htfAtr > 0
    bullDisp = htfC > htfO and htfBody >= dispMult * htfMedBody and htfBody >= minImpulseAtr * 0.5 * htfAtr
    bearDisp = htfC < htfO and htfBody >= dispMult * htfMedBody and htfBody >= minImpulseAtr * 0.5 * htfAtr

    if phase == 3 and not na(zoneExpiry) and time >= zoneExpiry
        phase := 0
        zoneTop := na
        zoneBot := na

    if phase == 0
        if bullDisp
            setupDir := 1
            impulseStart := htfL
            impulseEnd := htfC
            obHi := htfH
            obLo := htfL
            rangeHi := htfH
            rangeLo := htfL
            boxHi := htfH
            boxLo := htfL
            rangeBars := 0
            phase := 1
        else if bearDisp
            setupDir := -1
            impulseStart := htfH
            impulseEnd := htfC
            obHi := htfH
            obLo := htfL
            rangeHi := htfH
            rangeLo := htfL
            boxHi := htfH
            boxLo := htfL
            rangeBars := 0
            phase := 1

    else if phase == 1
        rangeBars += 1
        rangeHi := math.max(nz(rangeHi, htfH), htfH)
        rangeLo := math.min(nz(rangeLo, htfL), htfL)
        if setupDir == 1
            impulseEnd := math.max(nz(impulseEnd, htfH), htfH)
            impulseStart := math.min(nz(impulseStart, htfL), htfL)
        else
            impulseEnd := math.min(nz(impulseEnd, htfL), htfL)
            impulseStart := math.max(nz(impulseStart, htfH), htfH)

        width = rangeHi - rangeLo
        compact = width <= rangeAtrFrac * htfAtr * 2.5
        if rangeBars >= rangeMinBars and compact
            boxHi := rangeHi
            boxLo := rangeLo
            phase := 2
        else if rangeBars > rangeMaxBars
            phase := 0
            rangeBars := 0

    else if phase == 2
        rangeBars += 1
        // Structural break of locked consolidation box
        broken = setupDir == 1 ? htfC > boxHi : htfC < boxLo
        if broken
            if setupDir == 1
                impulseEnd := math.max(nz(impulseEnd, htfH), htfH)
                impulseStart := math.min(nz(impulseStart, htfL), htfL)
            else
                impulseEnd := math.min(nz(impulseEnd, htfL), htfL)
                impulseStart := math.max(nz(impulseStart, htfH), htfH)

            move = math.abs(impulseEnd - impulseStart)
            if move > 0 and move >= minImpulseAtr * htfAtr * 0.5
                if setupDir == 1
                    f1 = impulseEnd - fibLo * move
                    f2 = impulseEnd - fibHi * move
                    zoneTop := math.max(f1, f2)
                    zoneBot := math.min(f1, f2)
                else
                    f1 = impulseEnd + fibLo * move
                    f2 = impulseEnd + fibHi * move
                    zoneTop := math.max(f1, f2)
                    zoneBot := math.min(f1, f2)
                activeObHi := obHi
                activeObLo := obLo
                zoneExpiry := time + setupMaxHours * 60 * 60 * 1000
                phase := 3
            else
                phase := 0
                rangeBars := 0
        else if rangeBars > rangeMaxBars + 12
            phase := 0
            rangeBars := 0

zoneActive = phase == 3 and not na(zoneTop) and not na(zoneBot) and (na(zoneExpiry) or time < zoneExpiry)

// ═══════════════════════ 15m BOS + patterns ═══════════════════════
atr15 = ta.atr(14)
utcHour = hour(time, "UTC")
inSession = not useSession or (utcHour >= sessStart and utcHour < sessEnd)

volOk = not useVolGate or htfAtrPct >= volPctMin
trendLongOk = not useHtfSma or (not na(htfSma) and htfC > htfSma)
trendShortOk = not useHtfSma or (not na(htfSma) and htfC < htfSma)

ph = ta.pivothigh(high, bosSwing, bosSwing)
pl = ta.pivotlow(low, bosSwing, bosSwing)
var float lastSwingHigh = na
var float lastSwingLow = na
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

bosLong = zoneActive and setupDir == 1 and not na(lastSwingHigh) and close > lastSwingHigh
bosShort = zoneActive and setupDir == -1 and not na(lastSwingLow) and close < lastSwingLow

var bool bosDoneLong = false
var bool bosDoneShort = false
var int  bosBarLong = na
var int  bosBarShort = na

if not zoneActive
    bosDoneLong := false
    bosDoneShort := false
    bosBarLong := na
    bosBarShort := na

if zoneActive and bosLong and not bosDoneLong
    bosDoneLong := true
    bosBarLong := bar_index
if zoneActive and bosShort and not bosDoneShort
    bosDoneShort := true
    bosBarShort := bar_index

inZone = zoneActive and low <= zoneTop and high >= zoneBot

body = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
eps = syminfo.mintick

bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and body > math.abs(close[1] - open[1]) * 0.9
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and body > math.abs(close[1] - open[1]) * 0.9
bullPin = lowerWick >= pinWickRatio * math.max(body, eps) and upperWick <= math.max(body, eps) * 1.2 and close >= open
bearPin = upperWick >= pinWickRatio * math.max(body, eps) and lowerWick <= math.max(body, eps) * 1.2 and close <= open
bullRej = lowerWick >= 1.5 * math.max(body, eps) and close > open
bearRej = upperWick >= 1.5 * math.max(body, eps) and close < open

longPattern = bullEngulf or bullPin or bullRej
shortPattern = bearEngulf or bearPin or bearRej

retestOkLong = not useBosRetest or (bosDoneLong and not na(bosBarLong) and bar_index > bosBarLong)
retestOkShort = not useBosRetest or (bosDoneShort and not na(bosBarShort) and bar_index > bosBarShort)

var int lastEntryBar = na
cooled = na(lastEntryBar) or (bar_index - lastEntryBar >= cooldownBars)

longSetup = allowLong and zoneActive and setupDir == 1 and bosDoneLong and retestOkLong and inZone and longPattern and inSession and volOk and trendLongOk and cooled and strategy.position_size == 0
shortSetup = allowShort and zoneActive and setupDir == -1 and bosDoneShort and retestOkShort and inZone and shortPattern and inSession and volOk and trendShortOk and cooled and strategy.position_size == 0

longStopRaw = math.min(nz(activeObLo, zoneBot), zoneBot) - 0.1 * nz(atr15, 0)
longStop = math.min(longStopRaw, close * (1.0 - minStopPct))
longRisk = close - longStop
longOk = longRisk > 0 and longRisk / close >= minStopPct * 0.95
longTp = close + rrTarget * longRisk

shortStopRaw = math.max(nz(activeObHi, zoneTop), zoneTop) + 0.1 * nz(atr15, 0)
shortStop = math.max(shortStopRaw, close * (1.0 + minStopPct))
shortRisk = shortStop - close
shortOk = shortRisk > 0 and shortRisk / close >= minStopPct * 0.95
shortTp = close - rrTarget * shortRisk

longCondition = longSetup and longOk
shortCondition = shortSetup and shortOk

qtyLong = longRisk > 0 ? (strategy.equity * riskPct) / longRisk : na
qtyShort = shortRisk > 0 ? (strategy.equity * riskPct) / shortRisk : na

if longCondition and not na(qtyLong) and qtyLong > 0
    strategy.entry("Long", strategy.long, qty = qtyLong)
    strategy.exit("XL", from_entry = "Long", stop = longStop, limit = longTp)
    lastEntryBar := bar_index
    phase := 0
    zoneTop := na
    zoneBot := na
    bosDoneLong := false

if shortCondition and not na(qtyShort) and qtyShort > 0
    strategy.entry("Short", strategy.short, qty = qtyShort)
    strategy.exit("XS", from_entry = "Short", stop = shortStop, limit = shortTp)
    lastEntryBar := bar_index
    phase := 0
    zoneTop := na
    zoneBot := na
    bosDoneShort := false

// ═══════════════════════ Visuals ═══════════════════════
plotshape(showSignals and longCondition, title = "Long", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.small, text = "L")
plotshape(showSignals and shortCondition, title = "Short", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small, text = "S")

pZoneTop = plot(showZone and zoneActive ? zoneTop : na, "Zone Top", color = color.new(color.purple, 30), style = plot.style_linebr)
pZoneBot = plot(showZone and zoneActive ? zoneBot : na, "Zone Bot", color = color.new(color.purple, 30), style = plot.style_linebr)
fill(pZoneTop, pZoneBot, color = zoneActive ? color.new(color.purple, 85) : na, title = "Golden Zone")

plot(useHtfSma ? htfSma : na, "HTF SMA", color = color.new(color.orange, 40))
bgcolor(useSession and inSession ? color.new(color.blue, 94) : na)

var float actSL = na
var float actTP = na
if longCondition
    actSL := longStop
    actTP := longTp
if shortCondition
    actSL := shortStop
    actTP := shortTp
if strategy.position_size == 0 and strategy.position_size[1] != 0
    actSL := na
    actTP := na

plot(strategy.position_size != 0 ? actSL : na, "Stop", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 ? actTP : na, "TP", color = color.lime, style = plot.style_linebr, linewidth = 2)

var table info = table.new(position.top_right, 2, 9, bgcolor = color.new(#111111, 20), border_width = 1)
if barstate.islast
    phaseTxt = phase == 0 ? "idle" : phase == 1 ? "range" : phase == 2 ? "wait BRK" : "ZONE ON"
    table.cell(info, 0, 0, "Phase", text_color = color.gray)
    table.cell(info, 1, 0, phaseTxt, text_color = color.white)
    table.cell(info, 0, 1, "Dir", text_color = color.gray)
    table.cell(info, 1, 1, setupDir == 1 ? "LONG" : setupDir == -1 ? "SHORT" : "-", text_color = setupDir == 1 ? color.lime : setupDir == -1 ? color.red : color.gray)
    table.cell(info, 0, 2, "HTF ATR%ile", text_color = color.gray)
    table.cell(info, 1, 2, str.tostring(htfAtrPct, "#.0"), text_color = volOk ? color.lime : color.red)
    table.cell(info, 0, 3, "Session", text_color = color.gray)
    table.cell(info, 1, 3, inSession ? "YES" : "no", text_color = inSession ? color.lime : color.gray)
    table.cell(info, 0, 4, "BOS L/S", text_color = color.gray)
    table.cell(info, 1, 4, (bosDoneLong ? "L✓" : "L·") + " " + (bosDoneShort ? "S✓" : "S·"), text_color = color.aqua)
    table.cell(info, 0, 5, "Zone", text_color = color.gray)
    table.cell(info, 1, 5, zoneActive ? str.tostring(zoneBot, "#.##") + "-" + str.tostring(zoneTop, "#.##") : "—", text_color = color.fuchsia)
    table.cell(info, 0, 6, "Trades", text_color = color.gray)
    table.cell(info, 1, 6, str.tostring(strategy.closedtrades), text_color = color.white)
    wr = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : 0.0
    table.cell(info, 0, 7, "Winrate", text_color = color.gray)
    table.cell(info, 1, 7, str.tostring(wr, "#.1") + "%", text_color = wr >= 40 ? color.lime : color.orange)
    table.cell(info, 0, 8, "Net P&L", text_color = color.gray)
    table.cell(info, 1, 8, str.tostring(strategy.netprofit, "#.##"), text_color = strategy.netprofit >= 0 ? color.lime : color.red)

alertcondition(longCondition, "PMTS Long", "PMTS Improved LONG {{ticker}} @ {{close}}")
alertcondition(shortCondition, "PMTS Short", "PMTS Improved SHORT {{ticker}} @ {{close}}")
