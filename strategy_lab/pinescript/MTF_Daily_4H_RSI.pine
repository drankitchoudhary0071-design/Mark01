//@version=6
//══════════════════════════════════════════════════════════════════════════════
// MTF Daily + 4H RSI  |  Pine v6  |  HAR TRADE pe SL + TP (Strategy Tester)
//══════════════════════════════════════════════════════════════════════════════
// USE:
// 1. BTCUSDT.P → chart = 4H
// 2. Paste → Add to chart
// 3. Neeche Strategy Tester kholo
//
// Har entry ke saath Stop Loss + Take Profit LAGTA HAI (bracket exit).
// Bina SL/TP ke trade open reh jati thi → result blank dikhta tha.
//══════════════════════════════════════════════════════════════════════════════

strategy(
     title                   = "MTF Daily+4H RSI SLTP",
     shorttitle              = "MTF RSI SLTP",
     overlay                 = true,
     pyramiding              = 0,
     initial_capital         = 10000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 10,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.1,
     slippage                = 2,
     process_orders_on_close = true,
     calc_on_every_tick      = false,
     margin_long             = 100,
     margin_short            = 100,
     max_labels_count        = 200,
     max_bars_back           = 5000
 )

//── Inputs ────────────────────────────────────────────────────────────────────
string G1 = "Signal"
int    rsiLen  = input.int(14,  "RSI Length", group=G1)
int    osLvl   = input.int(30,  "Long RSI cross above", group=G1)
int    obLvl   = input.int(70,  "Short RSI cross below", group=G1)
string htf     = input.timeframe("1D", "Higher Timeframe", group=G1)
int    emaFast = input.int(50,  "HTF EMA Fast", group=G1)
int    emaSlow = input.int(200, "HTF EMA Slow", group=G1)

string G2 = "Stop Loss / Take Profit"
int    atrLen   = input.int(14,   "ATR Length", group=G2)
float  stopMult = input.float(1.5,"SL = ATR ×", minval=0.1, step=0.1, group=G2)
float  tpMult   = input.float(3.0,"TP = ATR ×", minval=0.1, step=0.1, group=G2)

string G3 = "Display"
bool showDash = input.bool(true, "Results table", group=G3)

//── HTF trend (confirmed daily) ───────────────────────────────────────────────
float htfFast = request.security(syminfo.tickerid, htf, ta.ema(close, emaFast)[1], barmerge.gaps_off, barmerge.lookahead_on)
float htfSlow = request.security(syminfo.tickerid, htf, ta.ema(close, emaSlow)[1], barmerge.gaps_off, barmerge.lookahead_on)
bool  htfBull = htfFast > htfSlow
bool  htfBear = htfFast < htfSlow

float rsi = ta.rsi(close, rsiLen)
float atr = ta.atr(atrLen)

bool longSig  = htfBull and ta.crossover(rsi, osLvl) and not na(atr) and atr > 0
bool shortSig = htfBear and ta.crossunder(rsi, obLvl) and not na(atr) and atr > 0

//── Lock SL/TP distances at entry (ticks) so bracket always works ─────────────
var float slTicks = na
var float tpTicks = na
var float slLine  = na
var float tpLine  = na

bool flat = strategy.position_size == 0

if flat and longSig
    // ticks from entry price — strategy.exit loss/profit YEHI use karta hai
    slTicks := math.max(1.0, math.round(stopMult * atr / syminfo.mintick))
    tpTicks := math.max(1.0, math.round(tpMult * atr / syminfo.mintick))
    strategy.entry("Long", strategy.long)
    // Absolute prices + tick offsets — dono, taaki TV pe SL/TP dikhe aur fill ho
    slLine := close - stopMult * atr
    tpLine := close + tpMult * atr
    strategy.exit("Long SLTP", from_entry="Long", stop=slLine, limit=tpLine, loss=slTicks, profit=tpTicks)

if flat and shortSig
    slTicks := math.max(1.0, math.round(stopMult * atr / syminfo.mintick))
    tpTicks := math.max(1.0, math.round(tpMult * atr / syminfo.mintick))
    strategy.entry("Short", strategy.short)
    slLine := close + stopMult * atr
    tpLine := close - tpMult * atr
    strategy.exit("Short SLTP", from_entry="Short", stop=slLine, limit=tpLine, loss=slTicks, profit=tpTicks)

//── Har bar SL/TP dubara set (warna TV kabhi bracket drop kar deta hai) ───────
if strategy.position_size > 0
    float avg = strategy.position_avg_price
    // Prefer locked tick exits; also refresh absolute levels from entry avg
    float sl = avg - stopMult * atr   // fallback if ticks missing
    float tp = avg + tpMult * atr
    if not na(slTicks) and not na(tpTicks)
        strategy.exit("Long SLTP", from_entry="Long", loss=slTicks, profit=tpTicks)
        slLine := avg - slTicks * syminfo.mintick
        tpLine := avg + tpTicks * syminfo.mintick
    else
        strategy.exit("Long SLTP", from_entry="Long", stop=sl, limit=tp)
        slLine := sl
        tpLine := tp

if strategy.position_size < 0
    float avg = strategy.position_avg_price
    float sl = avg + stopMult * atr
    float tp = avg - tpMult * atr
    if not na(slTicks) and not na(tpTicks)
        strategy.exit("Short SLTP", from_entry="Short", loss=slTicks, profit=tpTicks)
        slLine := avg + slTicks * syminfo.mintick
        tpLine := avg - tpTicks * syminfo.mintick
    else
        strategy.exit("Short SLTP", from_entry="Short", stop=sl, limit=tp)
        slLine := sl
        tpLine := tp

if flat and not flat[1]
    slTicks := na
    tpTicks := na
    slLine  := na
    tpLine  := na

//── Visuals: SL red / TP green ────────────────────────────────────────────────
plot(htfFast, "HTF EMA Fast", color=color.orange, linewidth=2)
plot(htfSlow, "HTF EMA Slow", color=color.blue, linewidth=2)
bgcolor(htfBull ? color.new(color.teal, 92) : htfBear ? color.new(color.red, 92) : na)

plotshape(longSig and flat,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.green, text="BUY",  textcolor=color.white, size=size.tiny)
plotshape(shortSig and flat, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.red,   text="SELL", textcolor=color.white, size=size.tiny)

plot(strategy.position_size != 0 ? slLine : na, "STOP LOSS",   color=color.red,  style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? tpLine : na, "TAKE PROFIT", color=color.lime, style=plot.style_linebr, linewidth=2)

//── Results table ─────────────────────────────────────────────────────────────
if showDash and barstate.islast
    int trades = strategy.closedtrades
    float net  = strategy.netprofit
    float ret  = strategy.initial_capital != 0 ? net / strategy.initial_capital * 100.0 : 0.0
    int wins = 0
    int losses = 0
    float gw = 0.0
    float gl = 0.0
    if trades > 0
        int first = strategy.closedtrades.first_index
        for i = first to first + trades - 1
            float p = strategy.closedtrades.profit(i)
            if p > 0
                wins += 1
                gw += p
            else if p < 0
                losses += 1
                gl += math.abs(p)
    float wr = trades > 0 ? wins * 100.0 / trades : 0.0
    float pf = gl > 0 ? gw / gl : gw > 0 ? 999.0 : 0.0

    var table t = table.new(position.top_right, 2, 8, bgcolor=color.new(#111111, 20), border_width=1)
    table.cell(t, 0, 0, "MTF RSI + SL/TP", bgcolor=#2962ff, text_color=color.white)
    table.cell(t, 1, 0, timeframe.period, bgcolor=#2962ff, text_color=color.white)
    table.cell(t, 0, 1, "Net Profit", text_color=color.white)
    table.cell(t, 1, 1, str.tostring(net, "#.##"), text_color=net >= 0 ? color.lime : color.red)
    table.cell(t, 0, 2, "Return %", text_color=color.white)
    table.cell(t, 1, 2, str.tostring(ret, "#.##") + "%", text_color=ret >= 0 ? color.lime : color.red)
    table.cell(t, 0, 3, "Trades", text_color=color.white)
    table.cell(t, 1, 3, str.tostring(trades), text_color=color.white)
    table.cell(t, 0, 4, "Win Rate", text_color=color.white)
    table.cell(t, 1, 4, str.tostring(wr, "#.#") + "%", text_color=color.white)
    table.cell(t, 0, 5, "Profit Factor", text_color=color.white)
    table.cell(t, 1, 5, str.tostring(pf, "#.##"), text_color=color.white)
    table.cell(t, 0, 6, "Open Trades", text_color=color.white)
    table.cell(t, 1, 6, str.tostring(strategy.opentrades), text_color=color.white)
    table.cell(t, 0, 7, "Equity", text_color=color.white)
    table.cell(t, 1, 7, str.tostring(strategy.equity, "#.##"), text_color=color.white)

alertcondition(longSig,  "Long",  "LONG {{ticker}} SL/TP on")
alertcondition(shortSig, "Short", "SHORT {{ticker}} SL/TP on")
