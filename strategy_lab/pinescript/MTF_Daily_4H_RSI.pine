//@version=6
// MTF Daily Trend + 4H RSI Mean-Reversion  (FIXED, Pine v6)
// Port of strategy_lab/strategies/mtf_daily_4h_rsi.py
//
// ★ FIXES:
// 1. Daily HTF NON-REPAINTING — sirf CLOSED daily bar
// 2. Sizing = percent_of_equity
// 3. SL/TP entry pe lock + har bar re-arm
// 4. Long/Short SL-TP direction sanity checks
// 5. PnL labels: green=profit, red=loss
// 6. Sirf 4H chart
//
// ★ SETUP: BTCUSDT.P / PAXGUSDT.P — timeframe **4 hours**
// Commission 0.1% | Slippage ~3 | ~1 year range

strategy(
     title                   = "MTF Daily+4H RSI (fixed v6)",
     shorttitle              = "MTF-D-4H-RSI-F",
     overlay                 = true,
     pyramiding              = 0,
     process_orders_on_close = true,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     dynamic_requests        = false,
     initial_capital         = 10000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 1,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.1,
     slippage                = 3,
     margin_long             = 100,
     margin_short            = 100
 )

grpSig = "Signal"
rsiLen  = input.int(14, "RSI period", minval=2, group=grpSig)
osLvl   = input.int(30, "Oversold cross-up (long)", minval=5, maxval=45, group=grpSig)
obLvl   = input.int(70, "Overbought cross-down (short)", minval=55, maxval=95, group=grpSig)
htfTf   = input.timeframe("1D", "Higher timeframe (daily)", group=grpSig)
emaFast = input.int(50, "Daily EMA fast", minval=2, group=grpSig)
emaSlow = input.int(200, "Daily EMA slow", minval=2, group=grpSig)

grpRisk = "Risk"
atrLen  = input.int(14, "ATR period", minval=1, group=grpRisk)
stopAtr = input.float(1.5, "Stop ATR multiple", minval=0.1, step=0.1, group=grpRisk)
tpAtr   = input.float(3.0, "TP ATR multiple", minval=0.1, step=0.1, group=grpRisk)
riskPct = input.float(1.0, "Risk % equity / trade", minval=0.1, step=0.1, group=grpRisk) / 100.0

grpVis = "Visuals"
showPnL = input.bool(true, "Show closed-trade PnL labels", group=grpVis)

tfOk = timeframe.isminutes and timeframe.multiplier == 240
if barstate.islastconfirmedhistory and not tfOk
    runtime.error("Use this strategy on the 4H chart only.")

// Confirmed closed daily EMA trend (no HTF lookahead / repaint)
f_daily_closed() =>
    eF = ta.ema(close, emaFast)
    eS = ta.ema(close, emaSlow)
    trend = eF > eS ? 1 : eF < eS ? -1 : 0
    [eF[1], eS[1], trend[1]]

[dEmaF, dEmaS, dTrend] = request.security(
     syminfo.tickerid, htfTf, f_daily_closed(),
     barmerge.gaps_off, barmerge.lookahead_on)

rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

longCond  = tfOk and not na(dTrend) and dTrend > 0 and ta.crossover(rsiVal, osLvl)
shortCond = tfOk and not na(dTrend) and dTrend < 0 and ta.crossunder(rsiVal, obLvl)

longStopX  = close - stopAtr * atrVal
longTpX    = close + tpAtr * atrVal
shortStopX = close + stopAtr * atrVal
shortTpX   = close - tpAtr * atrVal

f_qty_pct(entryPrice, stopPrice) =>
    distPct = math.abs(entryPrice - stopPrice) / entryPrice
    distPct > 0 ? 100.0 * riskPct / distPct : na

var float lockedSL = na
var float lockedTP = na

flat = strategy.position_size == 0
ok   = not na(atrVal) and atrVal > 0

if flat and ok and longCond
    qtyPct = f_qty_pct(close, longStopX)
    if not na(qtyPct) and qtyPct > 0 and longStopX < close and longTpX > close
        lockedSL := longStopX
        lockedTP := longTpX
        strategy.entry("Long", strategy.long, qty=qtyPct)
        strategy.exit("LX", from_entry="Long", stop=lockedSL, limit=lockedTP)

if flat and ok and shortCond
    qtyPct = f_qty_pct(close, shortStopX)
    if not na(qtyPct) and qtyPct > 0 and shortStopX > close and shortTpX < close
        lockedSL := shortStopX
        lockedTP := shortTpX
        strategy.entry("Short", strategy.short, qty=qtyPct)
        strategy.exit("SX", from_entry="Short", stop=lockedSL, limit=lockedTP)

if strategy.position_size > 0 and not na(lockedSL) and not na(lockedTP)
    strategy.exit("LX", from_entry="Long", stop=lockedSL, limit=lockedTP)

if strategy.position_size < 0 and not na(lockedSL) and not na(lockedTP)
    strategy.exit("SX", from_entry="Short", stop=lockedSL, limit=lockedTP)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    lockedSL := na
    lockedTP := na

plot(dEmaF, "Daily EMA50 (confirmed)", color=color.new(color.orange, 30), linewidth=1)
plot(dEmaS, "Daily EMA200 (confirmed)", color=color.new(color.blue, 30), linewidth=1)
bgcolor(dTrend > 0 ? color.new(color.teal, 94) : dTrend < 0 ? color.new(color.maroon, 94) : na)
plotshape(longCond and flat, style=shape.triangleup, location=location.belowbar, color=color.teal, size=size.small, text="L")
plotshape(shortCond and flat, style=shape.triangledown, location=location.abovebar, color=color.maroon, size=size.small, text="S")
plot(strategy.position_size > 0 ? lockedSL : na, "Long SL", color=color.red, style=plot.style_linebr)
plot(strategy.position_size > 0 ? lockedTP : na, "Long TP", color=color.green, style=plot.style_linebr)
plot(strategy.position_size < 0 ? lockedSL : na, "Short SL", color=color.red, style=plot.style_linebr)
plot(strategy.position_size < 0 ? lockedTP : na, "Short TP", color=color.green, style=plot.style_linebr)

if showPnL and strategy.closedtrades > 0
    n = strategy.closedtrades
    prevN = nz(strategy.closedtrades[1], 0)
    if n > prevN
        // v6: oldest trades may trim — use first_index-safe access
        tradeIdx = n - 1
        p = strategy.closedtrades.profit(tradeIdx)
        isWin = p > 0
        label.new(
             bar_index, high,
             (isWin ? "+" : "") + str.tostring(p, "#.##"),
             style=label.style_label_down,
             color=isWin ? color.new(color.teal, 20) : color.new(color.maroon, 20),
             textcolor=color.white,
             size=size.small)

alertcondition(longCond, "MTF Long", "MTF Daily+4H RSI long {{ticker}}")
alertcondition(shortCond, "MTF Short", "MTF Daily+4H RSI short {{ticker}}")
