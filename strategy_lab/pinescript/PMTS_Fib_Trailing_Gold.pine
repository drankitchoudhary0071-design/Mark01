//@version=6
// PMTS Fib Trailing — Gold (PAXG) friendly
// Entry 0.6 fib touch | SL = 0.7 fib ± buffer pts | TP = swing anchor
// Lab (PAXGUSDT 365d, full ~0.30% RT): best on 1H, buf≈3 pts (~+3.4% PF~1.65)

strategy("PMTS - Fib Trailing (0.6 Entry / 0.7 SL + buffer)",
     overlay=true,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     initial_capital=10000,
     currency=currency.USD,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     process_orders_on_close=true,
     pyramiding=0,
     margin_long=100,
     margin_short=100)

swingLen   = input.int(3, "Swing Pivot Lookback", minval=1)
entryLevel = input.float(0.6, "Entry Fib Level", step=0.001)
slLevel    = input.float(0.7, "SL Fib Level", step=0.001)
slBuffer   = input.float(3.0, "SL buffer points (below/above 0.7)", step=0.5, minval=0)
showZones  = input.bool(true, "Show Fib Levels")

phVal = ta.pivothigh(high, swingLen, swingLen)
plVal = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(phVal)
    lastSwingHigh := phVal
if not na(plVal)
    lastSwingLow := plVal

var string direction  = na
var float  anchorLow  = na
var float  anchorHigh = na
var float entryPlot = na
var float slPlot    = na
var float tpPlot    = na
var float lockedSL  = na
var float lockedTP  = na

bool longSignal  = false
bool shortSignal = false

if na(direction)
    if not na(lastSwingHigh) and not na(lastSwingLow)
        if close > lastSwingHigh
            direction  := "bull"
            anchorLow  := lastSwingLow
            anchorHigh := high
        else if close < lastSwingLow
            direction  := "bear"
            anchorHigh := lastSwingHigh
            anchorLow  := low

else if direction == "bull"
    if high > anchorHigh
        anchorHigh := high
    float entryPx = anchorHigh - (anchorHigh - anchorLow) * entryLevel
    float slRaw   = anchorHigh - (anchorHigh - anchorLow) * slLevel
    float slPx    = slRaw - slBuffer   // buffer pts BELOW 0.7
    float tpPx    = anchorHigh
    entryPlot := entryPx
    slPlot    := slPx
    tpPlot    := tpPx
    if strategy.position_size == 0 and low <= entryPx
        longSignal := true
    if close < slRaw
        float prevHigh = anchorHigh
        direction  := "bear"
        anchorHigh := prevHigh
        anchorLow  := low

else if direction == "bear"
    if low < anchorLow
        anchorLow := low
    float entryPx = anchorLow + (anchorHigh - anchorLow) * entryLevel
    float slRaw   = anchorLow + (anchorHigh - anchorLow) * slLevel
    float slPx    = slRaw + slBuffer   // buffer pts ABOVE 0.7
    float tpPx    = anchorLow
    entryPlot := entryPx
    slPlot    := slPx
    tpPlot    := tpPx
    if strategy.position_size == 0 and high >= entryPx
        shortSignal := true
    if close > slRaw
        float prevLow = anchorLow
        direction  := "bull"
        anchorLow  := prevLow
        anchorHigh := high

if longSignal
    lockedSL := slPlot
    lockedTP := tpPlot
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=lockedSL, limit=lockedTP)

if shortSignal
    lockedSL := slPlot
    lockedTP := tpPlot
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=lockedSL, limit=lockedTP)

if strategy.position_size > 0 and not na(lockedSL)
    strategy.exit("Long Exit", "Long", stop=lockedSL, limit=lockedTP)
if strategy.position_size < 0 and not na(lockedSL)
    strategy.exit("Short Exit", "Short", stop=lockedSL, limit=lockedTP)

plot(showZones ? entryPlot : na, color=color.yellow, title="0.6 Entry", style=plot.style_linebr)
plot(showZones ? slPlot : na, color=color.red, title="SL (0.7±buf)", style=plot.style_linebr)
plot(showZones ? tpPlot : na, color=color.lime, title="TP Anchor", style=plot.style_linebr)
plotshape(longSignal, location=location.belowbar, style=shape.triangleup, color=color.green, size=size.small)
plotshape(shortSignal, location=location.abovebar, style=shape.triangledown, color=color.red, size=size.small)

if barstate.islast
    var table t = table.new(position.top_right, 2, 6, border_width=1)
    float wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0
    float pf = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    table.cell(t, 0, 0, "PMTS Gold", bgcolor=color.blue, text_color=color.white)
    table.cell(t, 1, 0, timeframe.period, bgcolor=color.blue, text_color=color.white)
    table.cell(t, 0, 1, "Trades")
    table.cell(t, 1, 1, str.tostring(strategy.closedtrades))
    table.cell(t, 0, 2, "Win Rate")
    table.cell(t, 1, 2, str.tostring(wr, "#.#") + "%")
    table.cell(t, 0, 3, "Net Profit")
    table.cell(t, 1, 3, str.tostring(strategy.netprofit, "#.##"))
    table.cell(t, 0, 4, "Profit Factor")
    table.cell(t, 1, 4, na(pf) ? "n/a" : str.tostring(pf, "#.##"))
    table.cell(t, 0, 5, "SL buffer")
    table.cell(t, 1, 5, str.tostring(slBuffer) + " pts")
